{%- set containerClasses = [params.classes] if params.classes else [] -%}
{%- if params.stack -%}
  {%- set containerClasses = containerClasses.concat('tna-tags--stacked') -%}
{%- endif -%}
{%- if params.small -%}
  {%- set containerClasses = containerClasses.concat('tna-tags--small') -%}
{%- endif -%}
{%- set classes = containerClasses | join(' ') -%}
<ul class="tna-tags{% if classes %} {{ classes }}{% endif %}"{% for attribute, value in params.attributes %} {{ attribute }}{% if value !== '' %}="{{ value }}"{% endif %}{% endfor %}>
  {%- for item in params.items %}
  {%- set itemClasses = ([item.classes] if item.classes else []) | join(' ') -%}
  <li class="tna-tags__item{%- if item.selected %} tna-tags__item--selected{% endif %}">
    {%- if item.href %}
    <a href="{{ item.href }}" {%- if item.title %} aria-label="{{ item.title }}" title="{{ item.title }}"{% endif %} class="tna-tags__link{% if itemClasses %} {{ itemClasses }}{% endif %}"{% for attribute, value in item.attributes %} {{ attribute }}{% if value !== '' %}="{{ value }}"{% endif %}{% endfor %}>{{ item.label }}</a>
    {%- else %}
    <span class="tna-tags__link{% if itemClasses %} {{ itemClasses }}{% endif %}"{% for attribute, value in item.attributes %} {{ attribute }}{% if value !== '' %}="{{ value }}"{% endif %}{% endfor %}>{{ item.label }}</span>
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
